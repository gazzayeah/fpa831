# macOS
.DS_Store
**/.DS_Store

# Python / uv (commit uv.lock at repo root — CI uses --frozen)
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/.venv/
**/.pytest_cache/
**/*.egg-info/
.ruff_cache/
**/.ruff_cache/
dist/
build/
**/bundled_corpus/
**/bundled_fixtures/

# Local env and secrets
.env
.envrc
**/.env
*credentials*.json
*-service-account*.json
*.pem

# Agent run store and ADK / Agent Engine scratch
.local/
**/.local/
*.sqlite
.adk/
**/.adk/
.agent_engine_src/
**/.agent_engine_src/

# Cursor: keep .cursor/rules/ in git; ignore other local Cursor state
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Terraform (remote GCS state is source of truth; lockfile stays local like iac_main)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/tfplan.data
**/tfplan.txt
**/tfapply.txt
**/*.tfplan
**/.terraform.lock.hcl
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
**/.terraform.tfstate.lock.info
